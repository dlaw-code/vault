                     {
                         "id":  "notes",
                         "type":  "text",
                         "x":  0,
                         "y":  820,
                         "width":  1267.2,
                         "height":  120,
                         "angle":  0,
                         "strokeColor":  "#1e1e1e",
                         "backgroundColor":  "transparent",
                         "fillStyle":  "solid",
                         "strokeWidth":  2,
                         "strokeStyle":  "solid",
                         "roughness":  1,
                         "opacity":  100,
                         "groupIds":  [

                                      ],
                         "frameId":  null,
                         "roundness":  null,
                         "seed":  1064731197,
                         "version":  1,
                         "versionNonce":  801397985,
                         "isDeleted":  false,
                         "boundElements":  null,
                         "updated":  1,
                         "link":  null,
                         "locked":  false,
                         "text":  "Legend:  grey = SOL transfer via System Program CPI   |   purple = CPI to Turbin3 registration program   |   dashed = PDA derivation\n\nKey ideas:\n- Ownership comes from seeds: user → vault_state → vault. There is no owner field, so another signer derives different PDAs.\n- The vault PDA has no private key. The program signs for it with [\"vault\", vault_state, vault_bump] on withdraw and close.\n- withdraw forwards the user\u0027s signature into the registration CPI, so the user pays for the ApplicationAccount (once per wallet).",
                         "originalText":  "Legend:  grey = SOL transfer via System Program CPI   |   purple = CPI to Turbin3 registration program   |   dashed = PDA derivation\n\nKey ideas:\n- Ownership comes from seeds: user → vault_state → vault. There is no owner field, so another signer derives different PDAs.\n- The vault PDA has no private key. The program signs for it with [\"vault\", vault_state, vault_bump] on withdraw and close.\n- withdraw forwards the user\u0027s signature into the registration CPI, so the user pays for the ApplicationAccount (once per wallet).",
                         "fontSize":  16,
                         "fontFamily":  1,
                         "textAlign":  "left",
                         "verticalAlign":  "top",
                         "containerId":  null,
                         "lineHeight":  1.25,
                         "autoResize":  true
                     }
